{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "useTabs": false,
  "printWidth": 120,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "sortImports": {
    "internalPattern": ["@/", "@tribios/", "#"],
    "newlinesBetween": true,
    "customGroups": [
      {
        "groupName": "react",
        "elementNamePattern": [
          "react",
          "react-dom",
          "react-dom/**",
          "react-router",
          "react-router/**",
          "react-router-dom",
          "react-router-dom/**"
        ]
      },
      {
        "groupName": "antd",
        "elementNamePattern": ["antd", "@ant-design/**"]
      }
    ],
    "groups": [
      "react",
      "antd",
      ["type-builtin", "type-external", "type-internal", "value-builtin", "value-external", "internal"],
      ["type-parent", "type-sibling", "type-index", "value-parent", "value-sibling", "value-index"],
      ["side_effect_style", "style"],
      "unknown"
    ]
  },
  "ignorePatterns": [
    "dist",
    "node_modules",
    "src-tauri/target",
    "coverage",
    "pnpm-lock.yaml",
    "src/auto-imports.d.ts",
    "README.md"
  ]
}
